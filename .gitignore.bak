# Local-only tooling. The browser preview under site/ and the headless C++
# suites under tools/ stay on the machine that develops the menu; they are not
# part of what ships to the device build.
site/
tools/

# AIDE / ndk-build outputs and the generated menu-test binaries: everything
# under these trees is regenerated on the device or by sh tools/tests/run_tests.sh.
# Never tracked - a fresh clone must start clean.
build/
src/main/obj/
src/main/libs/
