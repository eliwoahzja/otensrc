#pragma once

#include "../../ImGui/imgui_settings.h"

#include <chrono>
#include <cctype>
#include <cstdio>
#include <ctime>
#include <string>
#include <cmath>

namespace font {
    extern ImFont* inter_semibold;
}

extern std::chrono::steady_clock::time_point appStartTime;

namespace floating_info {

inline std::string FormatTimeDuration(std::chrono::steady_clock::duration duration) {
    const auto hours   = std::chrono::duration_cast<std::chrono::hours>(duration).count();
    const auto minutes = std::chrono::duration_cast<std::chrono::minutes>(duration % std::chrono::hours(1)).count();
    const auto seconds = std::chrono::duration_cast<std::chrono::seconds>(duration % std::chrono::minutes(1)).count();
    char buffer[32] = {};
    std::snprintf(buffer, sizeof(buffer), "%02d:%02d:%02d", (int)hours, (int)minutes, (int)seconds);
    return std::string(buffer);
}

// Helper: lerp between two IM_COL32 colors
inline ImU32 LerpColor(ImU32 a, ImU32 b, float t) {
    int ar = (a >> 0)  & 0xFF, ag = (a >> 8)  & 0xFF, ab_ = (a >> 16) & 0xFF, aa = (a >> 24) & 0xFF;
    int br = (b >> 0)  & 0xFF, bg = (b >> 8)  & 0xFF, bb_ = (b >> 16) & 0xFF, ba = (b >> 24) & 0xFF;
    return IM_COL32(
        (int)(ar + (br - ar) * t),
        (int)(ag + (bg - ag) * t),
        (int)(ab_ + (bb_ - ab_) * t),
        (int)(aa + (ba - aa) * t)
    );
}

inline void Render(ImDrawList* draw, float screenWidth, float screenHeight) {
    if (draw == nullptr || Config.ExtraMenu.ClearDisplay) return;
    if (!font::inter_semibold) return;

    // ── Time & Date ───────────────────────────────────────────────────────────
    const auto now         = std::chrono::system_clock::now();
    std::time_t currentTime = std::chrono::system_clock::to_time_t(now);
    std::tm* localTime     = std::localtime(&currentTime);

    char dateStr[64] = {};
    char timeStr[64] = {};
    std::strftime(dateStr, sizeof(dateStr), "%B %d, %Y", localTime);
    std::strftime(timeStr, sizeof(timeStr), "%I:%M %p", localTime);
    for (char* p = dateStr; *p; ++p) *p = (char)std::toupper((unsigned char)*p);
    for (char* p = timeStr; *p; ++p) *p = (char)std::toupper((unsigned char)*p);

    auto currentDuration   = std::chrono::steady_clock::now() - appStartTime;
    std::string sessionTime = FormatTimeDuration(currentDuration);

    // ── Layout ────────────────────────────────────────────────────────────────
    const float scale   = c::scale;
    const float boxW    = 220.0f * scale;
    const float boxH    = 145.0f * scale;
    const float padding = 20.0f * scale;

    const float boxX = padding;
    const float boxY = screenHeight - padding - boxH;

    const float textX = boxX + 14.0f * scale;
    float       y     = boxY + 14.0f * scale;
    const float lineH = 16.5f * scale;

    // ── Animation values ──────────────────────────────────────────────────────
    const float t          = (float)ImGui::GetTime();
    const float pulse      = sinf(t * 2.8f) * 0.5f + 0.5f;
    const float fastPulse  = sinf(t * 6.0f) * 0.5f + 0.5f;
    const float slowDrift  = sinf(t * 0.7f) * 0.5f + 0.5f;
    const float scanOffset = fmodf(t * 28.0f * scale, boxH);  // scanline scroll
    const float dataFlow   = fmodf(t * 55.0f * scale, boxH);  // data stream scroll

    // ── Enable clipping so effects stay inside box ────────────────────────────
    draw->PushClipRect(
        ImVec2(boxX, boxY),
        ImVec2(boxX + boxW, boxY + boxH),
        true
    );

    // ── Deep layered outer glow ───────────────────────────────────────────────
    draw->PopClipRect();  // temporarily pop to draw glow outside
    for (int i = 4; i >= 1; --i) {
        float expand = (float)i * 5.0f * scale;
        int   alpha  = (int)((5 + 8 * pulse) * (5 - i));
        draw->AddRectFilled(
            ImVec2(boxX - expand, boxY - expand),
            ImVec2(boxX + boxW + expand, boxY + boxH + expand),
            IM_COL32(0, 100 + i * 15, 255, alpha),
            12.0f
        );
    }
    draw->PushClipRect(
        ImVec2(boxX, boxY),
        ImVec2(boxX + boxW, boxY + boxH),
        true
    );

    // ── Main dark background ──────────────────────────────────────────────────
    draw->AddRectFilled(
        ImVec2(boxX, boxY),
        ImVec2(boxX + boxW, boxY + boxH),
        IM_COL32(3, 6, 16, 235),
        6.0f
    );

    // ── Hex grid texture (drawn as dots pattern) ──────────────────────────────
    {
        const float hexSize  = 10.0f * scale;
        const float hexStepX = hexSize * 1.73f;
        const float hexStepY = hexSize * 1.5f;
        const int   dotAlpha = (int)(12 + 6 * slowDrift);
        int row = 0;
        for (float gy = boxY; gy < boxY + boxH + hexStepY; gy += hexStepY, ++row) {
            float xOffset = (row % 2 == 0) ? 0 : hexStepX * 0.5f;
            for (float gx = boxX + xOffset; gx < boxX + boxW + hexStepX; gx += hexStepX) {
                draw->AddCircleFilled(
                    ImVec2(gx, gy),
                    1.2f * scale,
                    IM_COL32(0, 160, 255, dotAlpha)
                );
            }
        }
    }

    // ── Vertical data stream (right side) ────────────────────────────────────
    {
        const float streamX = boxX + boxW - 18.0f * scale;
        const float segH    = 6.0f * scale;
        const float gap     = 4.0f * scale;
        float sy = boxY + dataFlow - boxH;
        while (sy < boxY + boxH) {
            int a = (int)(20 + 60 * (sinf(sy * 0.3f + t * 4.0f) * 0.5f + 0.5f));
            draw->AddRectFilled(
                ImVec2(streamX, sy),
                ImVec2(streamX + 2.0f * scale, sy + segH),
                IM_COL32(0, 200, 255, a)
            );
            sy += segH + gap;
        }
    }

    // ── Scanline pass ─────────────────────────────────────────────────────────
    {
        const float scanH = 2.0f * scale;
        const float scanStep = 5.0f * scale;
        for (float sy = boxY; sy < boxY + boxH; sy += scanStep) {
            draw->AddRectFilled(
                ImVec2(boxX, sy),
                ImVec2(boxX + boxW, sy + scanH),
                IM_COL32(0, 0, 0, 18)
            );
        }
        // Moving bright scanline
        draw->AddRectFilled(
            ImVec2(boxX, boxY + scanOffset - 1),
            ImVec2(boxX + boxW, boxY + scanOffset + 2),
            IM_COL32(0, 180, 255, (int)(30 + 20 * pulse))
        );
    }

    // ── Diagonal glint (top-left to center) ──────────────────────────────────
    {
        float glintT = fmodf(t * 0.6f, 1.0f);
        float gx     = boxX + boxW * glintT;
        float gy     = boxY + boxH * glintT * 0.5f;
        draw->AddCircleFilled(
            ImVec2(gx, gy),
            3.5f * scale,
            IM_COL32(150, 230, 255, (int)(60 * sinf(glintT * IM_PI)))
        );
    }

    // ── Blue gradient top overlay ─────────────────────────────────────────────
    draw->AddRectFilledMultiColor(
        ImVec2(boxX, boxY),
        ImVec2(boxX + boxW, boxY + boxH * 0.45f),
        IM_COL32(0, 70, 200, 38),
        IM_COL32(0, 120, 255, 22),
        IM_COL32(0, 0, 0, 0),
        IM_COL32(0, 0, 0, 0)
    );

    // ── Top accent bar (gradient) ─────────────────────────────────────────────
    const float barH = 3.0f * scale;
    draw->AddRectFilledMultiColor(
        ImVec2(boxX, boxY),
        ImVec2(boxX + boxW, boxY + barH),
        IM_COL32(0, 60, 180, 0),
        IM_COL32(40, 200, 255, 255),
        IM_COL32(40, 200, 255, 255),
        IM_COL32(0, 60, 180, 0)
    );
    // Thin sharp highlight below bar
    draw->AddRectFilledMultiColor(
        ImVec2(boxX, boxY + barH),
        ImVec2(boxX + boxW, boxY + barH + 1.0f),
        IM_COL32(255, 255, 255, 0),
        IM_COL32(255, 255, 255, 35),
        IM_COL32(255, 255, 255, 35),
        IM_COL32(255, 255, 255, 0)
    );

    // ── Bottom accent bar ─────────────────────────────────────────────────────
    draw->AddRectFilledMultiColor(
        ImVec2(boxX, boxY + boxH - barH),
        ImVec2(boxX + boxW, boxY + boxH),
        IM_COL32(0, 60, 180, 0),
        IM_COL32(0, 140, 255, 160),
        IM_COL32(0, 140, 255, 160),
        IM_COL32(0, 60, 180, 0)
    );

    // ── Outer glowing border ──────────────────────────────────────────────────
    const int borderA = (int)(170 + 85 * pulse);
    draw->AddRect(
        ImVec2(boxX, boxY),
        ImVec2(boxX + boxW, boxY + boxH),
        IM_COL32(0, 170, 255, borderA),
        6.0f, 0, 1.6f
    );
    // Inner subtle border
    draw->AddRect(
        ImVec2(boxX + 2.0f, boxY + 2.0f),
        ImVec2(boxX + boxW - 2.0f, boxY + boxH - 2.0f),
        IM_COL32(100, 210, 255, (int)(35 + 25 * pulse)),
        5.0f, 0, 0.7f
    );

    // ── Corner brackets (L-shaped) ────────────────────────────────────────────
    const float cLen   = 12.0f * scale;
    const float cThick = 1.8f;
    const ImU32 cornerColOuter = IM_COL32(0, 220, 255, (int)(220 + 35 * fastPulse));
    const ImU32 cornerColInner = IM_COL32(255, 255, 255, (int)(60 + 40 * fastPulse));
    // Top-left
    draw->AddLine(ImVec2(boxX,          boxY + cLen), ImVec2(boxX,          boxY), cornerColOuter, cThick);
    draw->AddLine(ImVec2(boxX,          boxY),         ImVec2(boxX + cLen,  boxY), cornerColOuter, cThick);
    draw->AddLine(ImVec2(boxX + 1.5f,  boxY + cLen * 0.5f), ImVec2(boxX + 1.5f, boxY + 1.5f), cornerColInner, 0.8f);
    // Top-right
    draw->AddLine(ImVec2(boxX + boxW - cLen, boxY), ImVec2(boxX + boxW, boxY), cornerColOuter, cThick);
    draw->AddLine(ImVec2(boxX + boxW,         boxY), ImVec2(boxX + boxW, boxY + cLen), cornerColOuter, cThick);
    // Bottom-left
    draw->AddLine(ImVec2(boxX, boxY + boxH - cLen), ImVec2(boxX, boxY + boxH), cornerColOuter, cThick);
    draw->AddLine(ImVec2(boxX, boxY + boxH),         ImVec2(boxX + cLen, boxY + boxH), cornerColOuter, cThick);
    // Bottom-right
    draw->AddLine(ImVec2(boxX + boxW, boxY + boxH - cLen), ImVec2(boxX + boxW, boxY + boxH), cornerColOuter, cThick);
    draw->AddLine(ImVec2(boxX + boxW, boxY + boxH),         ImVec2(boxX + boxW - cLen, boxY + boxH), cornerColOuter, cThick);

    // ── Title: CALL OF DUTY | 1.6.55 | ──────────────────────────────────────
    const char* title    = "CALL OF DUTY  |  1.6.55  |";
    const float fontSize = 14.8f * scale;

    // Multi-layer glow
    const int glowA = (int)(45 + 40 * pulse);
    for (int gi = 2; gi >= 0; --gi) {
        float off = (float)(gi + 1) * 1.0f;
        draw->AddText(font::inter_semibold, fontSize, ImVec2(textX - off, y - off), IM_COL32(0, 120, 255, glowA / (gi + 1)), title);
        draw->AddText(font::inter_semibold, fontSize, ImVec2(textX + off, y + off), IM_COL32(0, 120, 255, glowA / (gi + 1)), title);
    }
    // Main text — slight flicker
    const int titleA = (int)(215 + 40 * pulse + 10 * (sinf(t * 17.3f) > 0.97f ? 1.0f : 0.0f));
    draw->AddText(font::inter_semibold, fontSize, ImVec2(textX, y),
                  IM_COL32(100, 215, 255, titleA), title);

    // Underline with gradient
    float titleWidth = font::inter_semibold->CalcTextSizeA(fontSize, FLT_MAX, 0.0f, title).x;
    const float ulY  = y + 21.0f * scale;
    draw->AddRectFilledMultiColor(
        ImVec2(textX, ulY),
        ImVec2(textX + titleWidth, ulY + 1.8f),
        IM_COL32(0, 160, 255, 0),
        IM_COL32(120, 230, 255, (int)(240 + 15 * pulse)),
        IM_COL32(120, 230, 255, (int)(240 + 15 * pulse)),
        IM_COL32(0, 160, 255, 0)
    );
    // Glow under the underline
    draw->AddRectFilledMultiColor(
        ImVec2(textX, ulY + 1.8f),
        ImVec2(textX + titleWidth, ulY + 5.0f),
        IM_COL32(0, 160, 255, 0),
        IM_COL32(0, 180, 255, (int)(60 + 30 * pulse)),
        IM_COL32(0, 180, 255, (int)(60 + 30 * pulse)),
        IM_COL32(0, 160, 255, 0)
    );

    y += 34.0f * scale;

    // ── Separator ─────────────────────────────────────────────────────────────
    draw->AddRectFilledMultiColor(
        ImVec2(textX, y),
        ImVec2(textX + boxW - 30.0f * scale, y + 1.0f),
        IM_COL32(0, 100, 200, 0),
        IM_COL32(0, 150, 255, 200),
        IM_COL32(0, 150, 255, 200),
        IM_COL32(0, 100, 200, 0)
    );
    // Separator glow
    draw->AddRectFilledMultiColor(
        ImVec2(textX, y + 1.0f),
        ImVec2(textX + boxW - 30.0f * scale, y + 4.0f),
        IM_COL32(0, 0, 0, 0),
        IM_COL32(0, 160, 255, (int)(50 + 30 * pulse)),
        IM_COL32(0, 160, 255, (int)(50 + 30 * pulse)),
        IM_COL32(0, 0, 0, 0)
    );
    y += 9.0f * scale;

    // ── Content lines ─────────────────────────────────────────────────────────
    const ImColor labelCol(100, 185, 255, 195);
    const ImColor valueCol(210, 240, 255, 250);
    const ImColor sepCol(0, 160, 255, 170);

    auto DrawLine = [&](const char* label, const char* value, bool highlight = false) {
        // Label
        draw->AddText(font::inter_semibold, 12.2f * scale, ImVec2(textX, y), labelCol, label);
        float lw = font::inter_semibold->CalcTextSizeA(12.2f * scale, FLT_MAX, 0.0f, label).x;

        // Separator " : "
        const char* sep = " : ";
        draw->AddText(font::inter_semibold, 12.2f * scale, ImVec2(textX + lw, y), sepCol, sep);
        float sw = font::inter_semibold->CalcTextSizeA(12.2f * scale, FLT_MAX, 0.0f, sep).x;

        // Value with optional glow for highlight
        if (highlight) {
            int hA = (int)(30 + 20 * pulse);
            draw->AddText(font::inter_semibold, 12.2f * scale, ImVec2(textX + lw + sw - 1, y - 1),
                          IM_COL32(0, 200, 255, hA), value);
        }
        draw->AddText(font::inter_semibold, 12.2f * scale, ImVec2(textX + lw + sw, y), valueCol, value);

        y += lineH;
    };

    DrawLine("DATE",     dateStr);
    DrawLine("TIME",     timeStr,             true);
    DrawLine("PLAYTIME", sessionTime.c_str(), true);

    y += 6.0f * scale;

    // ── Bottom divider ────────────────────────────────────────────────────────
    draw->AddRectFilledMultiColor(
        ImVec2(textX, y),
        ImVec2(textX + boxW - 30.0f * scale, y + 1.0f),
        IM_COL32(0, 80, 180, 0),
        IM_COL32(0, 120, 220, 140),
        IM_COL32(0, 120, 220, 140),
        IM_COL32(0, 80, 180, 0)
    );
    y += 7.0f * scale;

    // ── Watermark: [ POWERED BY KAIRO ] ──────────────────────────────────────
    const char* wm     = "[ POWERED BY RODS ]";
    const float wmSize = 11.8f * scale;

    // Glow layers
    for (int gi = 2; gi >= 0; --gi) {
        float off = (float)(gi + 1) * 0.8f;
        int   a   = (int)((15 + 15 * pulse) / (gi + 1));
        draw->AddText(font::inter_semibold, wmSize, ImVec2(textX - off, y - off), IM_COL32(0, 140, 255, a), wm);
        draw->AddText(font::inter_semibold, wmSize, ImVec2(textX + off, y + off), IM_COL32(0, 140, 255, a), wm);
    }
    const int wmA = (int)(130 + 80 * pulse + 15 * (sinf(t * 13.7f) > 0.95f ? 1.0f : 0.0f));
    draw->AddText(font::inter_semibold, wmSize, ImVec2(textX, y),
                  IM_COL32(70, 190, 255, wmA), wm);

    draw->PopClipRect();
}

} // namespace floating_info
